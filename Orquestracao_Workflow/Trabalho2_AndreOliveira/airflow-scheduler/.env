# UID do usuário airflow dentro da imagem apache/airflow
AIRFLOW_UID=50000

# Credenciais do usuário admin da UI
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Fernet key: usada para criptografar conexões/variáveis no banco
# Gere uma nova com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLt0nFe9c0=

# IP da Máquina 1 — usado pelo docker-compose-machine2.yaml para conectar ao Postgres e Redis
# Em produção: troque pelo IP real da máquina 1
MACHINE1_IP=host-gateway
